  "cards": [
    {
      "dot": "cyan",
      "title": "Pantalla y rutas",
      "items": [
        "loadComponent: carga la página solo cuando se abre su ruta",
        ":id: parte de la URL que cambia, como el 1 de /starwars/1",
        "input.required: dato obligatorio que el padre le pasa al componente hijo",
        "routerLink: enlace que cambia de página sin recargar el navegador"
      ]
    },
    {
      "dot": "emerald",
      "title": "Lógica de datos",
      "items": [
        "HttpClient: herramienta de Angular para hacer peticiones HTTP",
        "Observable: respuesta que llegará más tarde",
        "subscribe: \"avísame cuando llegue\" y recibe la respuesta",
        "pipe(map): transforma la respuesta antes de entregarla; aquí llama al mapper"
      ]
    },
    {
      "dot": "amber",
      "title": "Fuera de la aplicación",
      "items": [
        "API: servidor que entrega datos",
        "GET: petición HTTP para leer datos",
        "JSON: formato de texto con pares clave: valor",
        "swapi.dev no pide clave"
      ]
    }
  ]
}
