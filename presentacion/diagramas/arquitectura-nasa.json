  "cards": [
    {
      "dot": "cyan",
      "title": "Pantalla y rutas",
      "items": [
        "routerLink: enlace sin recargar; routerLinkActive marca la página actual",
        "input.required: dato que el padre le pasa al hijo",
        "computed: se recalcula solo, como el total de peligrosos"
      ]
    },
    {
      "dot": "emerald",
      "title": "Lógica de datos",
      "items": [
        "Observable: respuesta que llega después; subscribe la recibe",
        "pipe(map): transforma la respuesta con el mapper",
        "?. y ??: valor por defecto si un dato no viene"
      ]
    },
    {
      "dot": "amber",
      "title": "Fuera de la aplicación",
      "items": [
        "API key: clave que la NASA pide en cada petición",
        "params: date para la foto; start_date y end_date para asteroides",
        "JSON: texto con pares clave: valor"
      ]
    }
  ]
